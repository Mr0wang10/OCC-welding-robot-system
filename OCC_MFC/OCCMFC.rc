/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        POPUP "&Toolbars"
        BEGIN
            MENUITEM "<placeholder>",               ID_VIEW_TOOLBAR
        END
        MENUITEM "Status &Bar",                 ID_VIEW_STATUS_BAR
        POPUP "Application &Look"
        BEGIN
            MENUITEM "Windows 2000(&2)",            ID_VIEW_APPLOOK_WIN_2000
            MENUITEM "Office XP(&X)",               ID_VIEW_APPLOOK_OFF_XP
            MENUITEM "Windows XP(&W)",              ID_VIEW_APPLOOK_WIN_XP
            MENUITEM "Office 2003(&3)",             ID_VIEW_APPLOOK_OFF_2003
            MENUITEM "Visual Studio 2005(&5)",      ID_VIEW_APPLOOK_VS_2005
            MENUITEM "Visual Studio 2008(&8)",      ID_VIEW_APPLOOK_VS_2008
            POPUP "Office 2007(&7)"
            BEGIN
                MENUITEM "&Blue style",                 ID_VIEW_APPLOOK_OFF_2007_BLUE
                MENUITEM "&Black style",                ID_VIEW_APPLOOK_OFF_2007_BLACK
                MENUITEM "&Silver style",               ID_VIEW_APPLOOK_OFF_2007_SILVER
                MENUITEM "&Aqua style",                 ID_VIEW_APPLOOK_OFF_2007_AQUA
            END
        END
    END
    POPUP "&Hide"
    BEGIN
        MENUITEM "&About OCC_MFC...",           ID_APP_ABOUT
    END
    POPUP "Robot"
    BEGIN
        MENUITEM "Clear All",                   ID_BUTTON_CLEAR_ALL
    END
    POPUP "Robot Model"
    BEGIN
        POPUP "Fanuc"
        BEGIN
            MENUITEM "M10iD12",                     ID_FANUC_M10ID12
        END
        POPUP "ABB"
        BEGIN
            MENUITEM "ABB 1410",                    ID_ABB_ABB1410
        END
        POPUP "EFORT"
        BEGIN
            MENUITEM "ER20D-C10",                   ID_EFORT_ER20D
        END
        POPUP "GSK"
        BEGIN
            MENUITEM "GSK RB08",                    ID_GSK_GSKRB08
            MENUITEM "GSK RB20",                    ID_GSK_GSKRB20
        END
        POPUP "Kawasaki"
        BEGIN
            MENUITEM "BA006N",                      ID_KAWASAKI_BA006N
        END
        POPUP "STEP"
        BEGIN
            MENUITEM "STEP SA1400",                 ID_STEP_STEPSA1400
            MENUITEM "STEP SA1800",                 ID_STEP_STEPSA1800
        END
    END
END

IDR_POPUP_EDIT MENU
